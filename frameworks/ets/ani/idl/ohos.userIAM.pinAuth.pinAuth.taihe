@!namespace("@ohos.userIAM.pinAuth", "pinAuth")

@!sts_inject("""
static { loadLibraryWithPermissionCheck("pinauth_ani", "@ohos.userIAM.pinAuth"); }
""")

struct PinComplexityPolicy {
     complexityReg: String;
     policyDescription: String;
}

function setPinValidityPeriod(userId: i32, validityPeriod: i64): void;

function getPinValidityPeriod(userId: i32): Optional<i64>;

function setPinDeletionDisabledState(userId: i32, isDisabled: bool): void;

function getPinDeletionDisabledState(userId: i32): Optional<bool>;

function setPinComplexityPolicy(userId: i32, policy: PinComplexityPolicy): void;

function getPinComplexityPolicy(userId: i32): Optional<PinComplexityPolicy>;
